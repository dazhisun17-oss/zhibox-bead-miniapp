.chart-match-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:16rpx;align-items:center;margin:18rpx 0;padding:20rpx;background:#fff7fa;border:2rpx solid #f3dce7;border-radius:22rpx;box-shadow:0 10rpx 28rpx rgba(105,86,123,.06)}.chart-match-card.ready{background:#effbf7;border-color:#bfeadc}.chart-match-icon{display:flex;width:52rpx;height:52rpx;align-items:center;justify-content:center;color:#c76891;background:#ffe1ed;border-radius:16rpx;font-size:25rpx;font-weight:900}.chart-match-card.ready .chart-match-icon{color:#2f826d;background:#ccefe5}.chart-match-card>view:nth-child(2){min-width:0}.chart-match-card>view:nth-child(2) text{display:block;overflow:hidden;color:#51566a;font-size:21rpx;font-weight:850;text-overflow:ellipsis;white-space:nowrap}.chart-match-card>view:nth-child(2) text:last-child{margin-top:6rpx;color:#9993a3;font-size:17rpx;font-weight:500}.chart-match-card button{width:132rpx;height:58rpx;margin:0;padding:0;font-size:18rpx;line-height:58rpx}.setting-card input[disabled]{color:#aaa5b1;background:#f5f2f5}

/* 图纸缩放与防误触锁定 */
.pattern-zoom-head{display:grid!important;grid-template-columns:minmax(0,1fr) auto;gap:14rpx;align-items:center}.pattern-zoom-head>view:first-child{min-width:0}.pattern-zoom-head>view:first-child text{display:block;color:#555b70;font-size:20rpx;font-weight:850}.pattern-zoom-head>view:first-child text:last-child{margin-top:5rpx;color:#9994a3;font-size:16rpx;font-weight:500}.pattern-head-actions{display:flex;gap:9rpx;align-items:center}.pattern-head-actions>view{padding:10rpx 14rpx;color:#a35c7c;background:#ffe8f1;border:2rpx solid transparent;border-radius:999rpx;font-size:17rpx;font-weight:850;white-space:nowrap}.pattern-head-actions>.pattern-lock.locked{color:#397b6d;background:#e8f8f4;border-color:#bfeade}.pattern-head-actions>.pattern-lock.unlocked{color:#b45f80;background:#fff0f5;border-color:#ff9cbc}.pattern-scroll{touch-action:none}

/* 历史图纸：双列图片卡片 */
.recent-section{margin-top:48rpx}.history-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22rpx 18rpx}.history-grid .recent-card{display:block;min-width:0;margin:0;padding:0;overflow:hidden;background:#fff;border:1rpx solid #eee8f1;border-radius:28rpx;box-shadow:0 14rpx 36rpx rgba(106,88,127,.09)}.recent-image-wrap{position:relative;width:100%;height:0;padding-bottom:100%;overflow:hidden;background:#f0f1f3}.recent-image-wrap>image,.recent-image-wrap>.recent-thumb{position:absolute;inset:0;width:100%;height:100%;border-radius:0}.recent-image-wrap>.recent-thumb{display:flex;align-items:center;justify-content:center;color:#8a647b;background:linear-gradient(145deg,#ffe0ec,#d8f4ee);font-size:52rpx;font-weight:900}.recent-type{position:absolute;top:14rpx;left:14rpx;padding:7rpx 12rpx;color:#6f5265!important;background:rgba(255,255,255,.9);border-radius:999rpx;font-size:16rpx!important;font-weight:850!important;box-shadow:0 4rpx 12rpx rgba(82,62,96,.08)}.recent-info{padding:22rpx 20rpx 18rpx}.history-grid .recent-title{display:block;overflow:hidden;color:#30384d;font-size:27rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.history-grid .recent-meta{display:block;overflow:hidden;margin-top:9rpx;color:#9493a2;font-size:18rpx;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.recent-footer{display:flex;align-items:center;justify-content:space-between;margin-top:16rpx}.recent-footer>text:first-child{color:#aaa5b1;font-size:18rpx;font-weight:500}.recent-menu{padding:4rpx 2rpx 8rpx 20rpx;color:#777b89!important;font-size:25rpx!important;font-weight:900!important;letter-spacing:2rpx;line-height:1}
